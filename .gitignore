# Security: Never commit API tokens, local env files, or PyPI/GitHub credentials
.env
.env.*
*.local
.pypirc
.pypirc.*
*token*

# Local historical script archive & internal planning/review drafts (kept strictly local)
r-pkg_tst/
REPLY_TO_ANTAGONISTIC_REVIEW*.md
